{
  "name": "ci-diagnostics-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small operations dashboard with synthetic service metrics.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "verify:config": "node scripts/verify-config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run verify:config && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
